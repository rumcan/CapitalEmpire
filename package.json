{
  "name": "react-vite-tailwind",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "esbuild tests/*.test.ts --bundle --platform=node --format=esm --outdir=output/tests --out-extension:.js=.mjs --log-level=warning && node --test \"output/tests/*.mjs\"",
    "assets:ground": "node scripts/assets/prep-ground.mjs",
    "assets:sprites": "node scripts/assets/prep-sprites.mjs",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "clsx": "2.1.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "playwright-core": "^1.64.0",
    "sharp": "^0.34.4",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.3.2",
    "vite-plugin-singlefile": "2.3.0"
  }
}
