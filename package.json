{
  "name": "react-vite-tailwind",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node --max-old-space-size=8192 node_modules/vite/bin/vite.js build",
    "preview": "vite preview",
    "test": "esbuild tests/*.test.ts --bundle --platform=node --format=esm --loader:.webp=empty --loader:.png=empty --outdir=output/tests --out-extension:.js=.mjs --log-level=warning && node --test \"output/tests/*.mjs\"",
    "assets:ground": "node scripts/assets/prep-ground.mjs",
    "assets:sprites": "node scripts/assets/prep-sprites.mjs",
    "assets:scales": "node scripts/assets/prep-scales.mjs",
    "lots:freeze": "node scripts/assets/freeze-lot-presets.mjs",
    "lots:check": "node scripts/assets/freeze-lot-presets.mjs --check",
    "lots:exam": "node scripts/lots/exam.mjs",
    "typecheck": "tsc --noEmit -p .",
    "ui:overflow": "node scripts/dev/ui-overflow.mjs",
    "bench": "node scripts/perf/bench.mjs",
    "worker:test": "bash scripts/worker/run.sh \"npm test\"",
    "worker:bench": "bash scripts/worker/run.sh \"npm run build && node scripts/perf/bench.mjs --serve --channel chrome --size 1\"",
    "sim:gate": "esbuild scripts/sim/gate.ts --bundle --platform=node --format=esm --loader:.webp=empty --loader:.png=empty --outfile=output/sim/gate.mjs --log-level=warning && node output/sim/gate.mjs",
    "town:gate": "esbuild scripts/sim/town-gate.ts --bundle --platform=node --format=esm --loader:.webp=empty --loader:.png=empty --outfile=output/sim/town-gate.mjs --log-level=warning && node output/sim/town-gate.mjs",
    "towns:gate": "esbuild scripts/sim/towns-gate.ts --bundle --platform=node --format=esm --loader:.webp=empty --loader:.png=empty --outfile=output/sim/towns-gate.mjs --log-level=warning && node output/sim/towns-gate.mjs",
    "fix:gate": "esbuild scripts/sim/fix-gate.ts --bundle --platform=node --format=esm --loader:.webp=empty --loader:.png=empty --outfile=output/sim/fix-gate.mjs --log-level=warning && node output/sim/fix-gate.mjs",
    "event:gate": "esbuild scripts/sim/event-gate.ts --bundle --platform=node --format=esm --loader:.webp=empty --loader:.png=empty --outfile=output/sim/event-gate.mjs --log-level=warning && node output/sim/event-gate.mjs",
    "biz:gate": "esbuild scripts/sim/biz-gate.ts --bundle --platform=node --format=esm --loader:.webp=empty --loader:.png=empty --outfile=output/sim/biz-gate.mjs --log-level=warning && node output/sim/biz-gate.mjs",
    "range:gate": "esbuild scripts/sim/range-gate.ts --bundle --platform=node --format=esm --loader:.webp=empty --loader:.png=empty --outfile=output/sim/range-gate.mjs --log-level=warning && node output/sim/range-gate.mjs",
    "range:fixture": "esbuild scripts/sim/range-fixture.ts --bundle --platform=node --format=esm --loader:.webp=empty --loader:.png=empty --outfile=output/sim/range-fixture.mjs --log-level=warning && node output/sim/range-fixture.mjs",
    "terrain:preview": "esbuild scripts/terrain/preview.ts --bundle --platform=node --format=esm --outfile=output/terrain/preview.mjs --log-level=warning && node output/terrain/preview.mjs"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "ktx2-encoder": "0.6.0",
    "playwright-core": "^1.64.0",
    "sharp": "^0.35.5",
    "tailwindcss": "4.1.17",
    "three": "0.186.1",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
